<script>
// Live IST Clock
function updateNSEClock() {
    var now = new Date();
    var utc = now.getTime() + (now.getTimezoneOffset() * 60000);
    var istOffset = 5.5 * 3600000; // 5 hours 30 minutes
    var istDate = new Date(utc + istOffset);
    
    var day = String(istDate.getDate()).padStart(2, '0');
    var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    var month = monthNames[istDate.getMonth()];
    var year = istDate.getFullYear();
    var dateStr = day + ' ' + month + ' ' + year;
    
    var hours = istDate.getHours();
    var ampm = hours >= 12 ? 'PM' : 'AM';
    hours = hours % 12;
    hours = hours ? hours : 12;
    var minutes = String(istDate.getMinutes()).padStart(2, '0');
    var seconds = String(istDate.getSeconds()).padStart(2, '0');
    var timeStr = String(hours).padStart(2, '0') + ':' + minutes + ':' + seconds + ' ' + ampm;
    
    var timeDateEl = document.getElementById('nseTimeDate');
    if (timeDateEl) {
        timeDateEl.innerHTML = '<i class="far fa-calendar-alt" style="color:#FF9933; margin-right:5px;"></i> ' + dateStr + '<br><i class="far fa-clock" style="color:#138808; margin-right:5px;"></i> ' + timeStr + ' (IST)';
    }
}
setInterval(updateNSEClock, 1000);
updateNSEClock();

var isNSELoading = false;
var nextRefreshTime = 0;
var countdownInterval = null;

function scheduleNextRefresh(delay) {
    nextRefreshTime = Date.now() + delay;
    if (countdownInterval) clearInterval(countdownInterval);
    countdownInterval = setInterval(function() {
        var timerEl = document.getElementById('nseRefreshTimer');
        if (!timerEl) return;
        
        if (isNSELoading) {
            timerEl.innerHTML = '<i class="fas fa-sync-alt fa-spin"></i> Fetching data from NSE...';
            return;
        }
        
        var remaining = Math.max(0, (nextRefreshTime - Date.now()) / 1000);
        if (remaining > 0) {
            timerEl.innerHTML = '<i class="fas fa-clock"></i> Next auto-refresh in ' + remaining.toFixed(1) + 's';
        } else {
            timerEl.innerHTML = '<i class="fas fa-sync-alt fa-spin"></i> Refreshing...';
        }
    }, 100);
}

function loadNSE() {
    if (isNSELoading) return;
    isNSELoading = true;
    
    var timerEl = document.getElementById('nseRefreshTimer');
    if (timerEl) timerEl.innerHTML = '<i class="fas fa-sync-alt fa-spin"></i> Fetching data from NSE...';

    fetch('?page=admin_dashboard&section=api_nse_data').then(function(r) { return r.json(); }).then(function(data) {
        var src = data._source || 'live';
        var sc = data.market_status === 'open' ? '#22c55e' : '#ef4444';
        var st = data.market_status === 'open' ? 'OPEN' : 'CLOSED';
        var ih = '';
        
        if (data.indices && data.indices.length > 0) {
            data.indices.forEach(function(idx) {
                var cls = idx.change >= 0 ? 'nse-idx-up' : 'nse-idx-down';
                var ar = idx.change >= 0 ? '&#9650;' : '&#9660;';
                ih += '<div class="nse-idx-item"><div class="nse-idx-name">' + idx.symbol + '</div><div class="nse-idx-val ' + cls + '">' + idx.last.toFixed(2) + ' <span style="font-size:11px">' + ar + ' ' + Math.abs(idx.change).toFixed(2) + ' (' + Math.abs(idx.changePercent).toFixed(2) + '%)</span></div></div>';
            });
        }
        
        document.getElementById('nseContent').innerHTML = '<div class="nse-ticker-title" style="margin-bottom:10px"><i class="fas fa-signal"></i> Market Status &mdash; <span style="color:' + sc + ';font-weight:700">' + st + '</span> <span style="color:#555;font-size:9px">[' + src + ']</span></div><div class="nse-indices">' + ih + '</div>';
        if (data.error) document.getElementById('nseContent').innerHTML += '<div style="color:#ef4444;font-size:12px;margin-top:8px"><i class="fas fa-exclamation-triangle"></i> ' + data.error + '</div>';
        
        function ft(id, rows, cols) {
            var tb = document.querySelector('#' + id + ' tbody');
            if (!rows || !rows.length) { 
                var emptyHtml = '<tr><td colspan="' + cols + '" style="text-align:center;color:var(--muted);padding:20px">No data</td></tr>';
                if (tb.innerHTML !== emptyHtml) tb.innerHTML = emptyHtml;
                return; 
            }
            var newHtml = rows.map(function(r) {
                var cls = (r.change || 0) >= 0 ? 'nse-idx-up' : 'nse-idx-down';
                var sg = (r.change || 0) >= 0 ? '+' : '';
                var symbolHtml = '';
                
                if (cols === 6) {
                    symbolHtml = '<td style="font-weight:600"><div>' + (r.name || r.symbol) + '</div><small style="color:#888;font-weight:400">' + r.symbol + '</small></td>';
                } else { 
                    symbolHtml = '<td style="font-weight:600">' + r.symbol + '</td>';
                }
                
                var h = symbolHtml + '<td style="font-weight:700">' + (r.last || 0).toFixed(2) + '</td><td class="' + cls + '" style="font-weight:600">' + sg + (r.change || 0).toFixed(2) + ' (' + sg + (r.changePercent || 0).toFixed(2) + '%)</td>';
                if (cols > 3) h += '<td>' + (r.high || 0).toFixed(2) + '</td><td>' + (r.low || 0).toFixed(2) + '</td><td>' + Number(r.volume || 0).toLocaleString() + '</td>';
                return '<tr>' + h + '</tr>';
            }).join('');
            
            if (tb.innerHTML !== newHtml) tb.innerHTML = newHtml;
        }
        ft('nseGainers', data.gainers, 3);
        ft('nseLosers', data.losers, 3);
        ft('nseWatchlist', data.watchlist, 6);
        isNSELoading = false;
        scheduleNextRefresh(500); 
    }).catch(function(err) {
        document.getElementById('nseContent').innerHTML = '<div style="color:#ef4444"><i class="fas fa-exclamation-triangle"></i> Data load failed: ' + err.message + '</div>';
        isNSELoading = false;
        scheduleNextRefresh(500); 
    });
}
loadNSE();
</script>

