<script>
function copyPass(){var el=document.getElementById('passDisplay');if(!el)return;var t=el.textContent;if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(function(){showOk(el)})}else{var r=document.createRange();r.selectNodeContents(el);var s=window.getSelection();s.removeAllRanges();s.addRange(r);document.execCommand('copy');s.removeAllRanges();showOk(el)}}
function showOk(el){var o=el.style.borderColor;el.style.borderColor='#16a34a';el.title='কপি হয়েছে!';setTimeout(function(){el.style.borderColor=o;el.title='ক্লিক করে কপি করুন'},1500)}
function copySQL(btn){var box=btn.previousElementSibling;var lines=box.textContent.split('\n');var sql=lines.find(function(l){return l.trim().indexOf('UPDATE')===0});if(!sql)sql=box.textContent;if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(sql.trim()).then(function(){btn.innerHTML='<i class="fas fa-check"></i> কপি হয়েছে!';setTimeout(function(){btn.innerHTML='<i class="fas fa-copy"></i> SQL কপি করুন'},2000)})}else{var ta=document.createElement('textarea');ta.value=sql.trim();document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);btn.innerHTML='<i class="fas fa-check"></i> কপি হয়েছে!';setTimeout(function(){btn.innerHTML='<i class="fas fa-copy"></i> SQL কপি করুন'},2000)}}
setTimeout(function(){document.querySelectorAll('.toast').forEach(function(t){if(t.parentNode)t.parentNode.removeChild(t)})},3200);
</script>
