/* পাসওয়ার্ড জেনারেটর */
function generateRandomPassword($length = 14) {
    $upper = 'ABCDEFGHJKLMNPQRSTUVWXYZ'; $lower = 'abcdefghjkmnpqrstuvwxyz';
    $numbers = '23456789'; $symbols = '@#$%&*!?'; $all = $upper . $lower . $numbers . $symbols;
    $pass = '';
    $pass .= $upper[random_int(0, strlen($upper) - 1)];
    $pass .= $lower[random_int(0, strlen($lower) - 1)];
    $pass .= $numbers[random_int(0, strlen($numbers) - 1)];
    $pass .= $symbols[random_int(0, strlen($symbols) - 1)];
    for ($i = 4; $i < $length; $i++) { $pass .= $all[random_int(0, strlen($all) - 1)]; }
    return str_shuffle($pass);
}
function checkPasswordStrength($pass) {
    $score = 0;
    if (strlen($pass) >= 8)  $score++; if (strlen($pass) >= 12) $score++;
    if (strlen($pass) >= 16) $score++; if (preg_match('/[A-Z]/', $pass)) $score++;
    if (preg_match('/[a-z]/', $pass)) $score++; if (preg_match('/[0-9]/', $pass)) $score++;
    if (preg_match('/[^A-Za-z0-9]/', $pass)) $score++;
    if ($score <= 2) return ['label' => 'দুর্বল', 'color' => '#dc2626', 'percent' => 25];
    if ($score <= 4) return ['label' => 'মাঝারি', 'color' => '#ca8a04', 'percent' => 50];
    if ($score <= 5) return ['label' => 'ভালো', 'color' => '#16a34a', 'percent' => 75];
    return ['label' => 'শক্তিশালী', 'color' => '#059669', 'percent' => 100];
}

/* ইউজার লিস্ট */
 $allUsers = $pdo->query("SELECT * FROM users ORDER BY id ASC")->fetchAll(PDO::FETCH_ASSOC);

/* POST হ্যান্ডেল */
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';

    if ($action === 'generate') {
        $generatedPass = !empty($_POST['custom_pass']) ? trim($_POST['custom_pass']) : generateRandomPassword((int)($_POST['pass_length'] ?? 14));
        $strength = checkPasswordStrength($generatedPass);
    }

    if ($action === 'update_password') {
        $username = trim($_POST['target_user'] ?? '');
        $newPass  = trim($_POST['new_password'] ?? '');
        if (empty($username) || empty($newPass)) { $msg = 'ইউজারনেম ও পাসওয়ার্ড দিন'; $msgType = 'error'; }
        else {
            $hash = password_hash($newPass, PASSWORD_DEFAULT);
            $stmt = $pdo->prepare("UPDATE users SET password = ? WHERE username = ?");
            $stmt->execute([$hash, $username]);
            if ($stmt->rowCount() > 0) {
                $msg = "'{$username}' এর পাসওয়ার্ড সফলভাবে আপডেট হয়েছে!"; $msgType = 'success';
                $generatedPass = $newPass; $lastUpdated = $username;
                $strength = checkPasswordStrength($newPass);
                $allUsers = $pdo->query("SELECT * FROM users ORDER BY id ASC")->fetchAll(PDO::FETCH_ASSOC);
            } else { $msg = "'{$username}' নামে কোনো ইউজার পাওয়া যায়নি"; $msgType = 'error'; }
        }
    }

    if ($action === 'create_user') {
        $username = trim($_POST['new_username'] ?? '');
        $newPass  = trim($_POST['new_user_pass'] ?? '');
        $fullName = trim($_POST['new_full_name'] ?? '') ?: 'অ্যাডমিন';
        if (empty($username) || empty($newPass)) { $msg = 'সব ফিল্ড পূরণ করুন'; $msgType = 'error'; }
        else {
            $chk = $pdo->prepare("SELECT id FROM users WHERE username = ?"); $chk->execute([$username]);
            if ($chk->fetch()) { $msg = "'{$username}' ইতোমধ্যে আছে"; $msgType = 'error'; }
            else {
                $hash = password_hash($newPass, PASSWORD_DEFAULT);
                $pdo->prepare("INSERT INTO users (username, password, full_name) VALUES (?, ?, ?)")->execute([$username, $hash, $fullName]);
                $msg = "নতুন ইউজার '{$username}' তৈরি হয়েছে!"; $msgType = 'success';
                $generatedPass = $newPass; $lastUpdated = $username;
                $strength = checkPasswordStrength($newPass);
                $allUsers = $pdo->query("SELECT * FROM users ORDER BY id ASC")->fetchAll(PDO::FETCH_ASSOC);
            }
        }
    }

    if ($action === 'delete_user') {
        $uid = (int)($_POST['user_delete_id'] ?? 0);
        $pdo->prepare("DELETE FROM users WHERE id = ?")->execute([$uid]);
        $msg = 'ইউজার মুছে ফেলা হয়েছে'; $msgType = 'success';
        $allUsers = $pdo->query("SELECT * FROM users ORDER BY id ASC")->fetchAll(PDO::FETCH_ASSOC);
    }
}

