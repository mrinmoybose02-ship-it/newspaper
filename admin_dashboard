<script>
function cps(v) {
    var b = document.getElementById('psB'), t = document.getElementById('psT'), s = 0;
    if (v.length >= 6) s++;
    if (v.length >= 10) s++;
    if (/[A-Z]/.test(v)) s++;
    if (/[0-9]/.test(v)) s++;
    if (/[^A-Za-z0-9]/.test(v)) s++;
    var l = [{w:'0%',c:'var(--border)',x:'At least 6 characters'},{w:'20%',c:'#dc2626',x:'Very Weak'},{w:'40%',c:'#f97316',x:'Weak'},{w:'60%',c:'#eab308',x:'Medium'},{w:'80%',c:'#22c55e',x:'Good'},{w:'100%',c:'#16a34a',x:'Strong'}];
    var r = l[s];
    b.style.width = r.w;
    b.style.background = r.c;
    t.textContent = r.x;
    t.style.color = r.c;
}
</script>

